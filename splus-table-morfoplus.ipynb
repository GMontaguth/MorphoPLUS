   "source": [
    "import pandas as pd\n",
    "from pylegs.io import *\n",
    "\n",
    "\n",
    "df=read_table()\n",
    "\n",
    "\n",
    "# === 2. Definir las columnas que realmente existen en tu df ===\n",
    "cols_keep = [\n",
    "    'z', 'ra', 'dec',\n",
    "    'FLUX_RADIUS_50', 'FLUX_RADIUS_90',\n",
    "    'r_auto', 'e_r_auto',\n",
    "    'u_auto', 'e_u_auto',\n",
    "    'J0378_auto', 'e_J0378_auto',\n",
    "    'J0395_auto', 'e_J0395_auto',\n",
    "    'J0410_auto', 'e_J0410_auto',\n",
    "    'J0430_auto', 'e_J0430_auto',\n",
    "    'g_auto', 'e_g_auto',\n",
    "    'J0515_auto', 'e_J0515_auto',\n",
    "    'J0660_auto', 'e_J0660_auto',\n",
    "    'i_auto', 'e_i_auto',\n",
    "    'z_auto', 'e_z_auto',\n",
    "    'J0861_auto', 'e_J0861_auto',\n",
    "    'Field'\n",
    "]\n",
    "\n",
    "# Nos quedamos solo con esas columnas\n",
    "df_reduced = df[cols_keep].copy()\n",
    "\n",
    "# === 3. Crear la columna ID tipo A119_1, A119_2, ... ===\n",
    "df_reduced['ID'] = [f\"A119_{i+1}\" for i in range(len(df_reduced))]\n",
    "\n",
    "# === 4. Crear columnas RA y DEC a partir de ra, dec ===\n",
    "df_reduced['RA'] = df_reduced['ra']\n",
    "df_reduced['DEC'] = df_reduced['dec']\n",
    "\n",
    "\n",
    "# === 6. (Opcional) Calcular ELONGATION si tenés A y B en el df original ===\n",
    "if ('A' in df.columns) and ('B' in df.columns):\n",
    "    df_reduced['ELONGATION'] = df['A'] / df['B']\n",
    "else:\n",
    "    df_reduced['ELONGATION'] = pd.NA\n",
    "\n",
    "# Copiar THETA y ELLIPTICITY si existen\n",
    "if 'THETA' in df.columns:\n",
    "    df_reduced['THETA'] = df['THETA']\n",
    "else:\n",
    "    df_reduced['THETA'] = pd.NA\n",
    "\n",
    "if 'ELLIPTICITY' in df.columns:\n",
    "    df_reduced['ELLIPTICITY'] = df['ELLIPTICITY']\n",
    "else:\n",
    "    df_reduced['ELLIPTICITY'] = pd.NA\n",
    "\n",
    "# === 7. Reordenar columnas para que queden parecido a tu formato estándar ===\n",
    "cols_final = [\n",
    "    'z', 'ra', 'dec',\n",
    "    'ID', 'RA', 'DEC', \n",
    "    'ELONGATION', 'THETA', 'ELLIPTICITY',\n",
    "    'FLUX_RADIUS_50', 'FLUX_RADIUS_90',\n",
    "    'r_auto', 'e_r_auto',\n",
    "    'u_auto', 'e_u_auto',\n",
    "    'J0378_auto', 'e_J0378_auto',\n",
    "    'J0395_auto', 'e_J0395_auto',\n",
    "    'J0410_auto', 'e_J0410_auto',\n",
    "    'J0430_auto', 'e_J0430_auto',\n",
    "    'g_auto', 'e_g_auto',\n",
    "    'J0515_auto', 'e_J0515_auto',\n",
    "    'J0660_auto', 'e_J0660_auto',\n",
    "    'i_auto', 'e_i_auto',\n",
    "    'z_auto', 'e_z_auto',\n",
    "    'J0861_auto', 'e_J0861_auto',\n",
    "    'Field'\n",
    "]\n",
    "\n",
    "df_reduced = df_reduced[cols_final]\n",
    "\n",
    "# === 8. Guardar el resultado ===\n",
    "df_reduced.to_csv('Catalogos/SPLUS_Table.csv', index=False)\n",
    "\n",
    "print(\"✅ Archivo 'SPLUS_Table.csv' guardado con éxito.\")\n"
   ]
  },
  
 "nbformat_minor": 5
